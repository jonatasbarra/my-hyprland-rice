{
  "icon_theme": "Zed (Default)",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark Pro"
  },
  "ui_font_family": "Inter",
  "ui_font_size": 14,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 13,
  "buffer_line_height": "comfortable",
  "format_on_save": "on",
  "autosave": "on_focus_change",
  "vim_mode": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 13,
    "shell": {
      "program": "/bin/zsh",
    },
  },
}
