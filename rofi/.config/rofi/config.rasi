configuration {
    modi:                   "drun,run,window";
    show-icons:             true;
    drun-display-format:    "{name}";
    font:                   "JetBrainsMono Nerd Font 13";
    icon-theme:             "Papirus-Dark";
    terminal:               "kitty";
    hover-select:           true;
    me-select-entry:        "";
    me-accept-entry:        "MousePrimary";
}

* {
    bg:                 #1a1b26bf;
    surface:            #24283b;
    border-color:       #292e42;
    fg:                 #c0caf5;
    comment:            #565f89;
    accent:             #7aa2f7;
    urgent:             #f7768e;
    background-color:   #1a1b26bf;
    text-color:         #c0caf5;
}

window {
    background-color:   @bg;
    border:             1px solid;
    border-color:       @border-color;
    border-radius:      12px;
    width:              480px;
    padding:            12px;
}

mainbox {
    background-color:   #1a1b26bf;
    children:           [ inputbar, listview ];
    spacing:            8px;
}

inputbar {
    background-color:   @surface;
    border-radius:      8px;
    padding:            8px 12px;
    children:           [ prompt, entry ];
    spacing:            8px;
}

prompt {
    text-color: @accent;
    font:       "JetBrainsMono Nerd Font Bold 13";
}

entry {
    text-color:         @fg;
    placeholder:        "Search...";
    placeholder-color:  @comment;
    cursor:             text;
}

listview {
    background-color:   #1a1b26bf;
    columns:            1;
    lines:              8;
    spacing:            4px;
    scrollbar:          false;
}

element {
    background-color:   #1a1b26bf;
    border-radius:      8px;
    padding:            8px 10px;
    spacing:            10px;
    children:           [ element-icon, element-text ];
    text-color:         #c0caf5;
    orientation:        horizontal;
}

element normal normal {
    background-color:   #1a1b26bf;
    text-color:         #c0caf5;
}

element normal urgent {
    background-color:   #1a1b26bf;
    text-color:         #f7768e;
}

element selected normal {
    background-color:   #24283b;
    text-color:         #7aa2f7;
}
element alternate normal {
    background-color:   #1a1b26bf;
    text-color:         #c0caf5;
}

element alternate urgent {
    background-color:   #1a1b26bf;
    text-color:         #f7768e;
}

element alternate active {
    background-color:   #1a1b26bf;
    text-color:         #7aa2f7;
}
